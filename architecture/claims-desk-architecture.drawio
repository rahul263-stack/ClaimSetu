<mxfile host="app.diagrams.net"><diagram id="p1" name="1 Platform architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="925" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;ClaimSetu: 360 platform architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AI does the routine work at every stage; people approve submissions and handle clinical disputes&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="900" height="55" as="geometry"/></mxCell><mxCell id="X" value="External systems" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#fde9d9;strokeColor=#c55a11;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="230" height="795" as="geometry"/></mxCell><mxCell id="X1" value="&lt;b&gt;Hospital information and billing system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Admissions, bills, discharge summaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="X"><mxGeometry x="20" y="45" width="190" height="72" as="geometry"/></mxCell><mxCell id="X2" value="&lt;b&gt;Insurer and TPA portals&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pre-authorisation, claims, queries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="X"><mxGeometry x="20" y="137" width="190" height="72" as="geometry"/></mxCell><mxCell id="X3" value="&lt;b&gt;NHCX gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;National claims exchange, FHIR APIs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="X"><mxGeometry x="20" y="229" width="190" height="72" as="geometry"/></mxCell><mxCell id="X4" value="&lt;b&gt;Claims networks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IHX, Medi Assist provider rails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="X"><mxGeometry x="20" y="321" width="190" height="72" as="geometry"/></mxCell><mxCell id="X5" value="&lt;b&gt;Government scheme portals&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PM-JAY and state schemes (later phase)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="X"><mxGeometry x="20" y="413" width="190" height="72" as="geometry"/></mxCell><mxCell id="X6" value="&lt;b&gt;Bank statements and payment advice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Settlement amounts and dates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="X"><mxGeometry x="20" y="505" width="190" height="72" as="geometry"/></mxCell><mxCell id="X7" value="&lt;b&gt;Email, SMS and WhatsApp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Payer queries, patient and doctor prompts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="X"><mxGeometry x="20" y="597" width="190" height="72" as="geometry"/></mxCell><mxCell id="A" value="People and channels" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#3a6ea5;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="1150" height="130" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;Hospital claims desk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Web app: upload, track, respond&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="A"><mxGeometry x="30" y="45" width="250" height="65" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;Treating doctor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Mobile prompts for missing clinical notes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="A"><mxGeometry x="310" y="45" width="250" height="65" as="geometry"/></mxCell><mxCell id="A3" value="&lt;b&gt;Hospital finance head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Scorecard: % settled, days to payment, deductions won back&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="A"><mxGeometry x="590" y="45" width="250" height="65" as="geometry"/></mxCell><mxCell id="A4" value="&lt;b&gt;Our operations team&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;We run the desk: reviewers, coders, appeals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="A"><mxGeometry x="870" y="45" width="250" height="65" as="geometry"/></mxCell><mxCell id="B" value="Workflow modules: the seven stages of a claim" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="240" width="1150" height="180" as="geometry"/></mxCell><mxCell id="B1" value="&lt;b&gt;1. Intake hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Letters, bills, summaries; linked by claim number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="B"><mxGeometry x="31" y="75" width="140" height="85" as="geometry"/></mxCell><mxCell id="B2" value="&lt;b&gt;2. Claim file builder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Deductions, bill lines, clinical facts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="B"><mxGeometry x="189" y="75" width="140" height="85" as="geometry"/></mxCell><mxCell id="B3" value="&lt;b&gt;3. Payer rules engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Check against policy and tariff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="B"><mxGeometry x="347" y="75" width="140" height="85" as="geometry"/></mxCell><mxCell id="B4" value="&lt;b&gt;4. Gap finder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;List missing evidence, ask owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="B"><mxGeometry x="505" y="75" width="140" height="85" as="geometry"/></mxCell><mxCell id="B5" value="&lt;b&gt;5. Submission composer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Assemble pre-auth and final packets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="B"><mxGeometry x="663" y="75" width="140" height="85" as="geometry"/></mxCell><mxCell id="B6" value="&lt;b&gt;6. Channel layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;File with approval, log everything&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="B"><mxGeometry x="821" y="75" width="140" height="85" as="geometry"/></mxCell><mxCell id="B7" value="&lt;b&gt;7. Query and appeals desk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Answer queries, reconcile, appeal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="B"><mxGeometry x="979" y="75" width="140" height="85" as="geometry"/></mxCell><mxCell id="C" value="Shared platform services" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#e8def8;strokeColor=#6b4fa0;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="460" width="1150" height="245" as="geometry"/></mxCell><mxCell id="C1" value="&lt;b&gt;Integration adapters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Portal automation, NHCX, HIS connectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="31" y="50" width="140" height="84" as="geometry"/></mxCell><mxCell id="C2" value="&lt;b&gt;Case orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;State machine, deadline clocks (1h / 3h)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="189" y="50" width="140" height="84" as="geometry"/></mxCell><mxCell id="C3" value="&lt;b&gt;Document AI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OCR, LLM extraction, source citations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="347" y="50" width="140" height="84" as="geometry"/></mxCell><mxCell id="C4" value="&lt;b&gt;Human review queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Confidence routing, maker and checker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="505" y="50" width="140" height="84" as="geometry"/></mxCell><mxCell id="C5" value="&lt;b&gt;Rules management&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;One rule file per payer: terms, rates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="663" y="50" width="140" height="84" as="geometry"/></mxCell><mxCell id="C6" value="&lt;b&gt;Deduction predictor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flags likely cuts before filing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="C"><mxGeometry x="821" y="50" width="140" height="84" as="geometry"/></mxCell><mxCell id="C7" value="&lt;b&gt;Outcome metering&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Recovered amounts, success-fee billing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="C"><mxGeometry x="979" y="50" width="140" height="84" as="geometry"/></mxCell><mxCell id="K1" value="&lt;b&gt;Schema registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;39 clinical properties, one file per domain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="31" y="146" width="200" height="80" as="geometry"/></mxCell><mxCell id="K2" value="&lt;b&gt;Entity catalogues&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Drugs, devices, procedures: one canonical name each&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="C"><mxGeometry x="253" y="146" width="200" height="80" as="geometry"/></mxCell><mxCell id="K3" value="&lt;b&gt;Bill checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Duplicates, often non-payable, price outliers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="475" y="146" width="200" height="80" as="geometry"/></mxCell><mxCell id="K4" value="&lt;b&gt;Price analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Billed against cut; unit-price spread&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="C"><mxGeometry x="697" y="146" width="200" height="80" as="geometry"/></mxCell><mxCell id="K5" value="&lt;b&gt;Priority scoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Ranks work by expected recovery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="C"><mxGeometry x="919" y="146" width="200" height="80" as="geometry"/></mxCell><mxCell id="D" value="Data layer (hosted in India, encrypted)" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#b8860b;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="745" width="1150" height="120" as="geometry"/></mxCell><mxCell id="D1" value="&lt;b&gt;Claim ledger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Queries, deductions, payments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="D"><mxGeometry x="31" y="44" width="140" height="62" as="geometry"/></mxCell><mxCell id="D2" value="&lt;b&gt;Bill lines&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Every charge, priced&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="D"><mxGeometry x="189" y="44" width="140" height="62" as="geometry"/></mxCell><mxCell id="D3" value="&lt;b&gt;Clinical facts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;With source text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="D"><mxGeometry x="347" y="44" width="140" height="62" as="geometry"/></mxCell><mxCell id="D4" value="&lt;b&gt;Document store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Scans, bills, letters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="D"><mxGeometry x="505" y="44" width="140" height="62" as="geometry"/></mxCell><mxCell id="D5" value="&lt;b&gt;Payer rules library&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Limits, exclusions, rates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="D"><mxGeometry x="663" y="44" width="140" height="62" as="geometry"/></mxCell><mxCell id="D6" value="&lt;b&gt;Denial knowledge base&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Payer, reason, result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="D"><mxGeometry x="821" y="44" width="140" height="62" as="geometry"/></mxCell><mxCell id="D7" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Who did what, when&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="D"><mxGeometry x="979" y="44" width="140" height="62" as="geometry"/></mxCell><mxCell id="S" value="Trust and compliance" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#f8d7da;strokeColor=#a94442;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1460" y="70" width="230" height="795" as="geometry"/></mxCell><mxCell id="S1" value="&lt;b&gt;Patient consent and notices&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DPDP Act duties from May 2027&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a94442;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S"><mxGeometry x="20" y="45" width="190" height="72" as="geometry"/></mxCell><mxCell id="S2" value="&lt;b&gt;Hospital authorisation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Written mandate to act on its behalf&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a94442;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S"><mxGeometry x="20" y="137" width="190" height="72" as="geometry"/></mxCell><mxCell id="S3" value="&lt;b&gt;Approval before every submission&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No filing without hospital sign-off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a94442;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S"><mxGeometry x="20" y="229" width="190" height="72" as="geometry"/></mxCell><mxCell id="S4" value="&lt;b&gt;Role-based access&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Least privilege, masked identifiers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a94442;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S"><mxGeometry x="20" y="321" width="190" height="72" as="geometry"/></mxCell><mxCell id="S5" value="&lt;b&gt;Incident response&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;72-hour breach report, CERT-In 6 hours&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a94442;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S"><mxGeometry x="20" y="413" width="190" height="72" as="geometry"/></mxCell><mxCell id="S6" value="&lt;b&gt;Clinical safety rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Never create or alter clinical facts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a94442;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S"><mxGeometry x="20" y="505" width="190" height="72" as="geometry"/></mxCell><mxCell id="S7" value="&lt;b&gt;Hospital-side only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No revenue from insurers, ever&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a94442;fontSize=12;fontColor=#1c2430;spacing=4;strokeWidth=3;strokeColor=#b8860b;fillColor=#fff8dc;" vertex="1" parent="S"><mxGeometry x="20" y="597" width="190" height="72" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B2" target="B3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B3" target="B4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B4" target="B5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B5" target="B6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B6" target="B7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="cases, approvals, answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="every stage calls shared services" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;startArrow=classic;" edge="1" parent="1" source="B" target="C"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="read and write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;startArrow=classic;" edge="1" parent="1" source="C" target="D"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.361;entryX=0;entryY=0.5;" edge="1" parent="1" source="X" target="B1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.606;startArrow=classic;" edge="1" parent="1" source="C1" target="X"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="denial outcomes update the rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;dashed=1;strokeColor=#1f7a6d;fontColor=#1f7a6d;" edge="1" parent="1" source="B7" target="B3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Solid arrows: flow of work and data. Dashed arrow: learning loop. Left: systems we connect to. Right: controls that apply to every layer. &lt;b&gt;Gold outline: what makes the platform hard to copy (see page 4). Build status of every part is on page 5.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1500" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 Claim lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="&lt;b&gt;One cashless claim, from admission to settlement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Green: done by the platform. Blue: hospital. Purple: our reviewers. Orange: insurer or TPA.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1100" height="55" as="geometry"/></mxCell><mxCell id="LH" value="Hospital" style="swimlane;html=1;startSize=44;horizontal=0;rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#3a6ea5;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2400" height="135" as="geometry"/></mxCell><mxCell id="LP" value="Platform (AI)" style="swimlane;html=1;startSize=44;horizontal=0;rounded=1;arcSize=6;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="2400" height="135" as="geometry"/></mxCell><mxCell id="LR" value="Our reviewers" style="swimlane;html=1;startSize=44;horizontal=0;rounded=1;arcSize=6;fillColor=#e8def8;strokeColor=#6b4fa0;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="2400" height="135" as="geometry"/></mxCell><mxCell id="LY" value="Insurer or TPA" style="swimlane;html=1;startSize=44;horizontal=0;rounded=1;arcSize=6;fillColor=#fde9d9;strokeColor=#c55a11;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="2400" height="135" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Upload admission documents&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LH"><mxGeometry x="62" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Extract and build the claim file&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="217" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Check against payer rules&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="372" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Gaps or low confidence?&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rhombus;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=10;spacing=2;" vertex="1" parent="LP"><mxGeometry x="522" y="28" width="140" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Doctor or desk supplies missing evidence&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LH"><mxGeometry x="527" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Reviewer verifies uncertain fields&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8def8;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LR"><mxGeometry x="527" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Compose pre-authorisation packet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="682" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Hospital approves the packet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LH"><mxGeometry x="837" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Submit through portal or NHCX&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="992" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Payer decides (1-hour rule)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LY"><mxGeometry x="992" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Query raised?&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rhombus;fillColor=#fde9d9;strokeColor=#c55a11;fontSize=10;spacing=2;" vertex="1" parent="LY"><mxGeometry x="1142" y="28" width="140" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Draft the query answer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="1302" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Reviewer approves the answer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8def8;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LR"><mxGeometry x="1302" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;At discharge: compose final bill packet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="1457" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Hospital approves the final claim&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LH"><mxGeometry x="1612" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Submit the final claim&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="1767" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Payer authorises discharge (3-hour rule), then pays&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LY"><mxGeometry x="1767" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Reconcile payment against the bank&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="1922" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Short-paid or denied?&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rhombus;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=10;spacing=2;" vertex="1" parent="LP"><mxGeometry x="2072" y="28" width="140" height="80" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Case closed; finance sees the result&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LH"><mxGeometry x="2077" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Draft appeal with evidence&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LP"><mxGeometry x="2232" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Specialist reviews the appeal&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8def8;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LR"><mxGeometry x="2232" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Appeal filed; outcome recorded&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9d9;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;fontSize=11;" vertex="1" parent="LY"><mxGeometry x="2232" y="37" width="130" height="62" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n3" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="gaps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="d1" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="recheck" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="low confidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n9" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="resubmit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n11" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;jettySize=14;" edge="1" parent="1" source="d2" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n16" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="d3" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2" value="Every appeal outcome and reviewer correction is written to the denial knowledge base, which tightens the rules check for the next claim." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="1300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 Build phases"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t3" value="&lt;b&gt;What to build, in what order&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Phase timings are proposals from the report, not validated commitments&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1000" height="55" as="geometry"/></mxCell><mxCell id="P1" value="Phase 1 (months 0-3): deduction and denial audit" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="450" height="520" as="geometry"/></mxCell><mxCell id="P1b0" value="&lt;b&gt;Settlement letter and bill upload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bulk upload, no hospital integration needed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P1"><mxGeometry x="25" y="50" width="400" height="72" as="geometry"/></mxCell><mxCell id="P1b1" value="&lt;b&gt;Deduction extraction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Each disallowed line, amount and stated reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P1"><mxGeometry x="25" y="142" width="400" height="72" as="geometry"/></mxCell><mxCell id="P1b2" value="&lt;b&gt;Recoverable or not&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Classify against policy terms and tariff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P1"><mxGeometry x="25" y="234" width="400" height="72" as="geometry"/></mxCell><mxCell id="P1b3" value="&lt;b&gt;Appeal drafts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Evidence-linked letters for reviewer sign-off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P1"><mxGeometry x="25" y="326" width="400" height="72" as="geometry"/></mxCell><mxCell id="P1b4" value="&lt;b&gt;Recovery tracker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Amount contested, won, pending; basis for the success fee&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P1"><mxGeometry x="25" y="418" width="400" height="72" as="geometry"/></mxCell><mxCell id="P2" value="Phase 2 (months 3-12): live claims desk" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#3a6ea5;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="450" height="520" as="geometry"/></mxCell><mxCell id="P2b0" value="&lt;b&gt;Intake and claim file builder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Live admissions, document checklist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P2"><mxGeometry x="25" y="50" width="400" height="72" as="geometry"/></mxCell><mxCell id="P2b1" value="&lt;b&gt;Payer rules engine and gap finder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Top 5 payers first, then widen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P2"><mxGeometry x="25" y="142" width="400" height="72" as="geometry"/></mxCell><mxCell id="P2b2" value="&lt;b&gt;Submission with hospital approval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Operator-driven portal filing, NHCX where live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P2"><mxGeometry x="25" y="234" width="400" height="72" as="geometry"/></mxCell><mxCell id="P2b3" value="&lt;b&gt;Query handling against the clock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1-hour and 3-hour deadline tracking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P2"><mxGeometry x="25" y="326" width="400" height="72" as="geometry"/></mxCell><mxCell id="P2b4" value="&lt;b&gt;Review console&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Confidence routing, maker and checker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P2"><mxGeometry x="25" y="418" width="400" height="72" as="geometry"/></mxCell><mxCell id="P3" value="Phase 3 (months 12-24): scale and expand" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#e8def8;strokeColor=#6b4fa0;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="450" height="520" as="geometry"/></mxCell><mxCell id="P3b0" value="&lt;b&gt;Hospital system connectors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Direct feeds replace uploads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P3"><mxGeometry x="25" y="50" width="400" height="72" as="geometry"/></mxCell><mxCell id="P3b1" value="&lt;b&gt;Reconciliation with bank data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Automatic short-payment detection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P3"><mxGeometry x="25" y="142" width="400" height="72" as="geometry"/></mxCell><mxCell id="P3b2" value="&lt;b&gt;Government scheme claims&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PM-JAY and state scheme workflows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P3"><mxGeometry x="25" y="234" width="400" height="72" as="geometry"/></mxCell><mxCell id="P3b3" value="&lt;b&gt;Receivables financing partner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Lender uses the claim ledger as underwriting data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P3"><mxGeometry x="25" y="326" width="400" height="72" as="geometry"/></mxCell><mxCell id="P3b4" value="&lt;b&gt;US revenue-cycle delivery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Same engine, offshore delivery team&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b4fa0;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="P3"><mxGeometry x="25" y="418" width="400" height="72" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2.5;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#44546a;strokeWidth=1.5;fontSize=10;fontColor=#44546a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2.5;" edge="1" parent="1" source="P2" target="P3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3" value="Phase 1 needs no payer or hospital system integration, so it tests the two riskiest assumptions first: that deductions are recoverable and that hospitals will pay a success fee." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1400" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 Why it is hard to copy"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t4" value="&lt;b&gt;Five positions that make the platform hard to copy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Each one is built into a named part of the platform (gold outline on page 1), not added as a feature&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1100" height="55" as="geometry"/></mxCell><mxCell id="h0" value="&lt;b&gt;Position&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#0d2b45;strokeColor=#0d2b45;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="290" height="36" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;Where it lives in the platform&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#0d2b45;strokeColor=#0d2b45;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="75" width="520" height="36" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Why competitors struggle to follow&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#0d2b45;strokeColor=#0d2b45;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="75" width="570" height="36" as="geometry"/></mxCell><mxCell id="r0a" value="&lt;b&gt;1. Paid only on money recovered&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#fff8dc;strokeColor=#b8860b;strokeWidth=3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="123" width="290" height="84" as="geometry"/></mxCell><mxCell id="r0b" value="Deduction audit as the entry product (page 3, phase 1). Outcome metering measures what was contested and won, and bills the success fee from the claim ledger." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#6b4fa0;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="123" width="520" height="84" as="geometry"/></mxCell><mxCell id="r0c" value="Vendors selling software licences or financing earn whether or not the claim is paid, so matching this means changing their revenue model." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#a94442;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="123" width="570" height="84" as="geometry"/></mxCell><mxCell id="r1a" value="&lt;b&gt;2. Own the denial data&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#fff8dc;strokeColor=#b8860b;strokeWidth=3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="290" height="84" as="geometry"/></mxCell><mxCell id="r1b" value="Denial knowledge base records payer, procedure, stated reason and appeal result. The deduction predictor uses it to flag likely cuts before filing. Stage 7 feeds outcomes back to stage 3." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#6b4fa0;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="219" width="520" height="84" as="geometry"/></mxCell><mxCell id="r1c" value="No public dataset exists. It only accumulates by handling claims, so a later entrant starts from zero." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#a94442;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="219" width="570" height="84" as="geometry"/></mxCell><mxCell id="r2a" value="&lt;b&gt;3. Hospital-side only&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#fff8dc;strokeColor=#b8860b;strokeWidth=3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="290" height="84" as="geometry"/></mxCell><mxCell id="r2b" value="A standing rule in trust and compliance: no revenue from insurers. Every engagement runs under a written hospital mandate." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#6b4fa0;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="315" width="520" height="84" as="geometry"/></mxCell><mxCell id="r2c" value="Networks and administrators paid by insurers cannot credibly contest a deduction on the hospital's behalf." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#a94442;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="315" width="570" height="84" as="geometry"/></mxCell><mxCell id="r3a" value="&lt;b&gt;4. Narrow and deep first&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#fff8dc;strokeColor=#b8860b;strokeWidth=3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="411" width="290" height="84" as="geometry"/></mxCell><mxCell id="r3b" value="Payer rules library built for the top five payers and two or three specialties in one city, with every rule versioned in rules management." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#6b4fa0;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="411" width="520" height="84" as="geometry"/></mxCell><mxCell id="r3c" value="Generic products cover every payer adequately. Depth per payer and procedure only comes from repetition." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#a94442;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="411" width="570" height="84" as="geometry"/></mxCell><mxCell id="r4a" value="&lt;b&gt;5. Operator, not a tool&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#fff8dc;strokeColor=#b8860b;strokeWidth=3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="507" width="290" height="84" as="geometry"/></mxCell><mxCell id="r4b" value="Our operations team runs the desk through the review console and human review queue. The case orchestrator tracks the 1-hour and 3-hour deadlines." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#6b4fa0;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="507" width="520" height="84" as="geometry"/></mxCell><mxCell id="r4c" value="A software vendor would have to build a delivery team and carry service commitments." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#ffffff;strokeColor=#a94442;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="507" width="570" height="84" as="geometry"/></mxCell><mxCell id="proof" value="&lt;b&gt;Proof, published for every hospital&lt;/b&gt;&lt;br&gt;Share of claimed value settled. Days from discharge to payment. Share of contested deductions won back. Each compared with the hospital's own baseline before we started." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#d5f0e6;strokeColor=#1f7a6d;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="615" width="690" height="90" as="geometry"/></mxCell><mxCell id="caveat" value="&lt;b&gt;What this depends on&lt;/b&gt;&lt;br&gt;Positions 1 and 2 assume deductions are recoverable, which is not yet confirmed. If the first audits show most cuts are valid contractual ones, the product shifts to preventing deductions before filing." style="whiteSpace=wrap;html=1;fontSize=11;fontColor=#1c2430;rounded=1;fillColor=#fde9d9;strokeColor=#c55a11;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="615" width="690" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 Build status"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t5" value="&lt;b&gt;Where the build stands&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Status of each part of the architecture after the current MVP. &quot;Tested&quot; means run end to end on synthetic sample documents, not on real hospital data.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1300" height="55" as="geometry"/></mxCell><mxCell id="S1" value="Built and tested in demo mode" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#d5f0e6;strokeColor=#1f7a6d;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="470" height="786" as="geometry"/></mxCell><mxCell id="S1b0" value="&lt;b&gt;Intake of three document types&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Settlement letter, itemised bill, discharge summary; linked by claim number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="48" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b1" value="&lt;b&gt;Deduction assessment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Keyword rules; every verdict goes to a reviewer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="114" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b2" value="&lt;b&gt;Review queue and priority scoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sorted by expected recovery, bulk confirm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="180" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b3" value="&lt;b&gt;Appeal workflow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Draft, edit, approve, mark filed; placeholders block approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="246" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b4" value="&lt;b&gt;Outcome metering&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Won, partly won, lost; success fee&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="312" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b5" value="&lt;b&gt;Denial knowledge base&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Payer by reason, with win rates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="378" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b6" value="&lt;b&gt;Schema registry and catalogues&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;39 properties, 4 domains, 29 catalogue entries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="444" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b7" value="&lt;b&gt;Bill checks and price analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Duplicates, price spread, billed against cut&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="510" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b8" value="&lt;b&gt;Audit report, CSV export, activity log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Printable summary for the hospital&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="576" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b9" value="&lt;b&gt;Payer rules engine (synthetic rules)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Terms allow against payer cut&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="642" width="430" height="56" as="geometry"/></mxCell><mxCell id="S1b10" value="&lt;b&gt;Pre-filing check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fix, collect, attach checklist; prediction kept for comparison&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f7a6d;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S1"><mxGeometry x="20" y="708" width="430" height="56" as="geometry"/></mxCell><mxCell id="S2" value="Written but never run on real input" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#3a6ea5;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="70" width="470" height="786" as="geometry"/></mxCell><mxCell id="S2b0" value="&lt;b&gt;Reading real PDFs and scans&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Letters, bills and summaries through Claude; needs an API key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S2"><mxGeometry x="20" y="48" width="430" height="56" as="geometry"/></mxCell><mxCell id="S2b1" value="&lt;b&gt;AI-written appeal letters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Template letters are used until then&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S2"><mxGeometry x="20" y="114" width="430" height="56" as="geometry"/></mxCell><mxCell id="S2b2" value="&lt;b&gt;Document type and domain detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Runs on sample text only so far&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3a6ea5;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S2"><mxGeometry x="20" y="180" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3" value="Not built yet" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=6;fillColor=#fde9d9;strokeColor=#c55a11;fontStyle=1;fontSize=14;fontColor=#0d2b45;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="470" height="786" as="geometry"/></mxCell><mxCell id="S3b0" value="&lt;b&gt;Real payer rule files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Actual policy schedules and signed tariffs, per payer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="48" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b1" value="&lt;b&gt;Submission composer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pre-authorisation and final claim packets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="114" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b2" value="&lt;b&gt;Channel layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Payer portals, NHCX, claims networks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="180" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b3" value="&lt;b&gt;Hospital system connectors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Uploads only today&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="246" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b4" value="&lt;b&gt;Deduction predictor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Needs recorded outcomes first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="312" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b5" value="&lt;b&gt;Standard codes in catalogues&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Left blank until verified&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="378" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b6" value="&lt;b&gt;Logins, roles, encryption&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Single user on one machine today&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="444" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b7" value="&lt;b&gt;Multi-hospital accounts and benchmarks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Needs a consent and anonymisation model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="510" width="430" height="56" as="geometry"/></mxCell><mxCell id="S3b8" value="&lt;b&gt;Government scheme claims&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PM-JAY and state schemes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c55a11;fontSize=12;fontColor=#1c2430;spacing=4;" vertex="1" parent="S3"><mxGeometry x="20" y="576" width="430" height="56" as="geometry"/></mxCell><mxCell id="l5" value="In terms of the seven workflow stages: stages 1 and 2 (collect, extract) and stage 7 (appeals, reconciliation by hand) work in demo form. Stages 3 and 4 (rules check, gap finding before filing) work on invented payer terms. Stages 5 and 6 (composing and filing a live claim) are not built." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0d2b45;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="1480" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>